# ============================================================================
#  Configuration du Robot-Chasseur — copier en `.env` et renseigner.
#  Préfixe CHASSEUR_, délimiteur imbriqué "__" (ex: SCORING__DECOTE_TARGET).
#  TOUT est optionnel : sans rien, le mode démo (--demo) tourne hors-ligne.
# ============================================================================

# --- Curseurs financiers (l'investisseur) ----------------------------------
CHASSEUR_BUDGET_MAX=310000
CHASSEUR_SURFACE_MIN=25
CHASSEUR_SURFACE_MAX=120

# --- Seuils de scoring (dynamiques, jamais en dur dans le code) -------------
CHASSEUR_SCORING__DECOTE_TARGET=0.15          # -15% sous le marché = score plein
CHASSEUR_SCORING__ALERT_THRESHOLD=70          # score mini pour déclencher une alerte
CHASSEUR_SCORING__RENTAL_FOCUS=true           # pénalise les passoires (loi Climat)

# --- Recherche web futurs transports (Grand Paris Express) ------------------
# Fournisseur au choix : "tavily" | "serper" | "null" (désactivé)
CHASSEUR_SEARCH__PROVIDER=null
CHASSEUR_SEARCH__TAVILY_API_KEY=
CHASSEUR_SEARCH__SERPER_API_KEY=

# --- Anti-bot ---------------------------------------------------------------
# Proxies résidentiels (liste séparée par des virgules), profil d'impersonation
CHASSEUR_ANTIBOT__PROXIES=
CHASSEUR_ANTIBOT__IMPERSONATE=chrome
CHASSEUR_ANTIBOT__FLARESOLVERR_URL=http://localhost:8191/v1
CHASSEUR_ANTIBOT__MAX_RPM=20                  # requêtes/min/domaine (poli !)

# --- Alerting ---------------------------------------------------------------
CHASSEUR_ALERT__TELEGRAM_BOT_TOKEN=
CHASSEUR_ALERT__TELEGRAM_CHAT_ID=
CHASSEUR_ALERT__SMTP_HOST=
CHASSEUR_ALERT__SMTP_PORT=587
CHASSEUR_ALERT__SMTP_USER=
CHASSEUR_ALERT__SMTP_PASSWORD=
CHASSEUR_ALERT__EMAIL_TO=

# --- Stockage ---------------------------------------------------------------
CHASSEUR_DB_PATH=chasseur.sqlite
# Pour la prod géospatiale : postgresql://user:pwd@localhost:5432/chasseur
CHASSEUR_POSTGIS_DSN=
